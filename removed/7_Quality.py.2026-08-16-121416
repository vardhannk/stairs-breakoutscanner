    f'<div class="card-top"><div class="card-symbol">{pick}</div>'
    f'<span class="card-badges">{"".join(badges)}</span></div>'
    f'<div class="card-stat-row">{"".join(stats)}</div>'
    f'</div>',
    unsafe_allow_html=True,
)

q = d.get("quarters")
if q is None or len(q) < 2:
    st.info(
        f"No quarterly statements available for {pick}. Yahoo does not carry "
        f"them for every Indian listing; that is a gap in the source, and the "
        f"momentum figures above are unaffected."
    )
else:
    body = []
    idx = list(q.index)
    for i in range(len(q) - 1, -1, -1):
        rev, pat = q["rev"].iloc[i], q["pat"].iloc[i]
        rq = _pct(rev, q["rev"].iloc[i - 1]) if i >= 1 else None
        ry = _pct(rev, q["rev"].iloc[i - 4]) if i >= 4 else None
        pq = _pct(pat, q["pat"].iloc[i - 1]) if i >= 1 else None
        py = _pct(pat, q["pat"].iloc[i - 4]) if i >= 4 else None

        def cell(v, extra=""):
            if v is None:
                return f'<td class="na {extra}">n/a</td>'
            k = "g" if v >= 0 else "b"
            return f'<td class="{k} {extra}">{v:+.1f}%</td>'

        def rupees(v, extra=""):
            if v is None or v != v:
                return f'<td class="na {extra}">n/a</td>'
            return f'<td class="{extra}">{v / 1e7:,.0f}</td>'

        label = pd.Timestamp(idx[i]).strftime("%b %Y")
        body.append(
            f"<tr><td>{label}</td>{rupees(rev)}{cell(rq)}{cell(ry)}"
            f'{rupees(pat, "divl")}{cell(pq)}{cell(py)}</tr>'
        )

    st.markdown(
        '<table class="qtbl"><thead>'
        '<tr class="grp"><th></th><th class="rev" colspan="3">Revenue</th>'
        '<th class="pat divl" colspan="3">PAT (profit)</th></tr>'
        "<tr><th>Quarter</th><th>₹cr</th><th>QoQ</th><th>YoY</th>"
        '<th class="divl">₹cr</th><th>QoQ</th><th>YoY</th></tr>'
        "</thead><tbody>" + "".join(body) + "</tbody></table>",
        unsafe_allow_html=True,
    )
    st.caption(
        "QoQ compares with the previous quarter, YoY with the same quarter a "
        "year earlier — so YoY needs five quarters of history and reads n/a "
        "until there are. Every percentage is computed from the ₹cr column "
        "beside it. Where PAT grows faster than revenue, margins are widening."
    )

with st.expander("Why this page cannot screen the whole universe"):
    st.markdown("""
Fundamental data arrives **one HTTP request per company**. Prices do not —
`yf.download` takes a list and returns hundreds of symbols in a single call,
which is why the nightly build can cover 3,046 stocks in minutes.

There is no batch equivalent for fundamentals. At roughly a second per symbol,
the full universe is around an hour of sequential requests, every night,
against an endpoint under no obligation to serve it. So the choice is between
fundamentals that **confirm** a momentum shortlist, which is this page, and
fundamentals that **select** from the universe, which needs a data source with
bulk access — a paid API, or NSE's own XBRL filings parsed and stored.

The second is a real project, not an afternoon. This is the version that
works today and tells the truth about what it does not know.
""")
