def _pct(cur, prev):
    if cur is None or prev is None:
        return None
    try:
        cur, prev = float(cur), float(prev)
    except (TypeError, ValueError):
        return None
    if prev == 0 or prev != prev or cur != cur:
        return None
    return (cur / prev - 1.0) * 100.0


def growth(d, field, lag):
    q = d.get("quarters")
    if q is None or field not in q or len(q) <= lag:
        return None
    s = q[field].dropna()
    if len(s) <= lag:
        return None
    return _pct(s.iloc[-1], s.iloc[-1 - lag])


