def _num(x):
    try:
        v = float(x)
        return v if v == v else None      # NaN check without importing math
    except (TypeError, ValueError):
        return None


def _row_of(df, *names):
    """First matching row of a yfinance statement frame, as a float series."""
    if df is None or getattr(df, "empty", True):
        return None
    idx = {str(i).strip().lower(): i for i in df.index}
    for want in names:
        key = want.strip().lower()
        if key in idx:
            return pd.to_numeric(df.loc[idx[key]], errors="coerce")
    return None


@st.cache_data(ttl=6 * 3600, show_spinner=False)
def fetch_one(sym: str) -> dict:
    """Everything we want for one ticker. Never raises."""
    out = {"sym": sym, "ok": False, "quarters": None}
    if yf is None:
        out["err"] = "yfinance not installed"
        return out
    try:
        t = yf.Ticker(f"{sym}.NS")
        info = t.info or {}
    except Exception as e:
        out["err"] = str(e)[:120]
        return out
    for k, short_name in INFO_FIELDS.items():
        v = info.get(k)
        out[short_name] = v if short_name in ("y_sector", "industry") else _num(v)
    out["ok"] = any(out.get(v) is not None for v in INFO_FIELDS.values())

    # quarterly revenue and PAT, for real QoQ / YoY
    try:
        q = t.quarterly_income_stmt
        rev = _row_of(q, "Total Revenue", "Operating Revenue")
        pat = _row_of(q, "Net Income", "Net Income Common Stockholders")
        if rev is not None and pat is not None and len(rev) >= 2:
            frame = pd.DataFrame({"rev": rev, "pat": pat}).dropna(how="all")
            frame = frame.sort_index()          # oldest -> newest
            out["quarters"] = frame
    except Exception:
        pass
    return out


