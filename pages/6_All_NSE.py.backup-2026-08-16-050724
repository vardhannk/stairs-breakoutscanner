def _card_html(r) -> str:
    dirn = str(r.get("breakout_direction", "")).lower()
    cls = "bullish" if dirn.startswith("bull") else "bearish"
    dir_label = "🟢 Bullish" if dirn.startswith("bull") else "🔴 Bearish"
    tf = str(r.get("breakout_timeframes") or "—")

    badges = [f'<span class="card-pill">{tf}</span>',
              f'<span class="card-pill">{dir_label}</span>']
    p52 = _f(r, "pct_of_52w_high")
    if p52 is not None and p52 >= 99.0:
        badges.append('<span class="card-pill high52">52W High</span>')
    rs = _f(r, "rs_rating")
    if rs is None:
        # Undefined, not weak. Saying so on the card stops a blank column
        # being read as a bad score — which is exactly what happened when
        # NaN was stored as 0 and these stocks looked like the market's worst.
        badges.append('<span class="card-pill high52">No RS Yet</span>')
    elif rs >= 80:
        badges.append(f'<span class="card-pill high52">RS {rs:.0f}</span>')

    bp, vol = _f(r, "breakout_pct"), _f(r, "volume_ratio")
    sign = "+" if (bp or 0) >= 0 else ""
    close, lvl = _f(r, "close"), _f(r, "breakout_level")
    to, adr = _f(r, "turnover_30d_cr"), _f(r, "adr_pct_5d")
    r1 = _f(r, "ret_1m_rank")

    row1 = "".join(x for x in [
        f'<span class="card-stat">Close <b>₹{close:,.2f}</b></span>' if close else "",
        f'<span class="card-stat">Break <b>{sign}{bp:.2f}%</b></span>' if bp is not None else "",
        f'<span class="card-stat">Vol <b>{vol:.2f}×</b></span>' if vol is not None else "",
        f'<span class="card-stat">ADR <b>{adr:.1f}%</b></span>' if adr is not None else "",
    ])
    row2 = "".join(x for x in [
        f'<span class="card-stat">Level <b>₹{lvl:,.2f}</b></span>' if lvl else "",
        f'<span class="card-stat">RS <b>{rs:.0f}</b></span>' if rs is not None else "",
        f'<span class="card-stat">1m rank <b>{r1:.0f}</b></span>' if r1 is not None else "",
        f'<span class="card-stat">Turnover <b>₹{to:,.0f} cr</b></span>' if to is not None else "",
    ])

    foot = []
    if r.get("sector"):
        foot.append(str(r.get("sector")))
    lb = r.get("last_bar_date")
    traded = r.get("traded_today")
    if lb:
        foot.append(f"last bar {lb}"
                    + ("" if (traded is None or bool(traded))
                       else "  ⚠️ did not trade on the snapshot date"))

    return (f'<div class="breakout-card {cls}">'
            f'<div class="card-top">'
            f'<span class="card-symbol">{r.get("symbol")}</span>'
            f'<span class="card-badges">{"".join(badges)}</span></div>'
            f'<div class="card-stat-row">{row1}</div>'
            f'<div class="card-stat-row">{row2}</div>'
            f'<span class="card-foot">{" · ".join(foot)}</span></div>')


