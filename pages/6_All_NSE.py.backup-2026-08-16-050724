            label_visibility="collapsed", key=f"all_nse_view_{i}",
            index=0 if _default == "Cards" else 1)
        st.session_state["all_nse_view"] = view

        sub = rows
        if col == "__confluence__":
            # More than one timeframe agreeing. The old app called this
            # Confluence and it is the strongest filter here: a level that
            # gives way on the daily AND the weekly is a different event
            # from one that only shows on a single chart.
            sub = rows[rows["breakout_timeframes"].astype(str).str.contains(",")]
        elif col and col in rows.columns:
            sub = rows[rows[col].fillna(False).astype(bool)]
        if sub.empty:
            st.info("Nothing here with the current filters.")
            continue
        st.caption(f"{len(sub)} stocks")
        if view == "Table":
            pairs = [(c, lbl) for c, lbl in TABLE_COLS if c in sub.columns]
            t = sub[[c for c, _ in pairs]].copy()
            if "breakout_direction" in t.columns:
                t["breakout_direction"] = t["breakout_direction"].astype(str).map(
                    lambda v: "🟢 Bullish" if v.lower().startswith("bull")
                    else ("🔴 Bearish" if v.lower().startswith("bear") else v))
            for b in ("breakout_is_52w_high",):
                if b in t.columns:
                    t[b] = t[b].map(lambda v: "Yes" if bool(v) else "No")
            if "breakout_lookback" in t.columns:
                t["breakout_lookback"] = t["breakout_lookback"].astype("Int64")
            st.dataframe(t.rename(columns=dict(pairs)).round(2),
                         hide_index=True, use_container_width=True)
        else:
            cap = min(len(sub), 60)
            cc = st.columns(2)
            for i in range(cap):
                r = sub.iloc[i].to_dict()
                with cc[i % 2]:
                    _render(_card_html(r))
