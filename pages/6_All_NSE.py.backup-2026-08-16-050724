def _render(html: str) -> None:
    if hasattr(st, "html"):
        st.html(html)
    else:
        st.markdown(html, unsafe_allow_html=True)


def _f(row, key):
    try:
        v = float(row.get(key))
        return v if v == v else None
    except (TypeError, ValueError):
        return None


